NODE_ENV=development
PORT=4000

# PostgreSQL — عدّل كلمة المرور واسم القاعدة حسب إعدادك المحلي
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/radnas

# Auth — استبدلها بسلسلة عشوائية طويلة في الإنتاج
JWT_SECRET=dev-only-change-me-to-a-long-random-secret-string

# CORS — أصل الواجهة الأمامية (Vite)
CORS_ORIGIN=http://localhost:5173

