# RadNas backend — production environment
# Copy to  backend/.env  on the server and fill the real values.

NODE_ENV=production
PORT=4000

# PostgreSQL (created in DEPLOY.md §3). Use a STRONG password (no spaces).
DATABASE_URL=postgres://radnas:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/radnas

# Session signing secret — MUST be >= 16 chars. Generate a strong one:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run__openssl_rand_hex_32

# Public origin of the panel (the domain/subdomain SPanel serves over HTTPS).
# For an IP-only trial you can temporarily use  http://<SERVER_IP>
CORS_ORIGIN=https://radnas.example.com
