# ── RadNas tenant stack — copy to ".env" (or "acme.env" per company) and fill in ──

# External PostgreSQL (runs OUTSIDE Docker — on the host or a dedicated DB server).
# The DATABASE + role must already exist; migrations only create the schema inside it.
DB_HOST=host.docker.internal        # host Postgres via the Docker host-gateway; or a server IP/DNS
DB_PORT=5432
DB_USER=radnas
DB_PASSWORD=CHANGE_ME_strong_alphanumeric   # keep alphanumeric (used in the RADIUS sql config)
DB_NAME=radnas                      # per-tenant: e.g. radnas_acme

# App
JWT_SECRET=CHANGE_ME_long_random_at_least_16_chars
APP_URL=http://localhost:8080               # public URL for CORS, e.g. https://acme.radnas.com

# Host port mappings — give EACH tenant its own unique ports
WEB_PORT=8080
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_COA_PORT=3799
